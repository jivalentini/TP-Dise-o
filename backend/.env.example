# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgresql+psycopg://tp_user:tp_pass@localhost:5432/tp_evaluaciones

# Sesión
JWT_SECRET=cambiar-esto-en-produccion
JWT_EXPIRE_MINUTES=60

# Autenticación: mock | ldap
AUTH_MODE=mock
MOCK_USERS=CONSULTOR:consultor123
LDAP_SERVER=ldap://localhost:389
LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=capitalhumano,dc=com

# Sistemas externos
# IA (CU033 preguntas / CU009 puestos): mock | api | anthropic
IA_MODE=mock
IA_BASE_URL=
IA_API_KEY=
IA_MODEL=claude-sonnet-4-5
SISTEMA_CANDIDATOS_URL=
SISTEMA_CANDIDATOS_API_KEY=
# Nombre de la cola CUPS/IPP para el CU028; vacío = imprime el navegador
IMPRESORA_URI=

# CU032: cada cuántos minutos corre la finalización de cuestionarios (0 = desactivado)
BATCH_INTERVALO_MINUTOS=60
